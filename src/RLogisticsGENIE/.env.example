# RLogisticsGENIE local env example — copy to .env (do not commit secrets)

RLOGISTICS_URL=http://localhost:5088
RLOGISTICS_API_KEY=rlogistics-demo-coord-key-change-me
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- LLM vendor (switch once → both low + high use that vendor) ---
# offline | azure | openai | gemini | ollama | claude
LLM_VENDOR=offline
LLM_DEFAULT_TIER=low
# GENIE_LLM_MODE=offline  # legacy alias

# Azure OpenAI chat
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_LLM_LOW_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_LLM_HIGH_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI
# OPENAI_API_KEY=...
# OPENAI_LLM_LOW_MODEL=gpt-4o-mini
# OPENAI_LLM_HIGH_MODEL=gpt-4o

# Gemini
# GEMINI_API_KEY=...
# GEMINI_LLM_LOW_MODEL=gemini-2.0-flash-lite
# GEMINI_LLM_HIGH_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# Claude
# ANTHROPIC_API_KEY=...
# CLAUDE_LLM_LOW_MODEL=claude-3-5-haiku-latest
# CLAUDE_LLM_HIGH_MODEL=claude-3-5-sonnet-latest

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_LOW_MODEL=llama3.2:3b
# OLLAMA_LLM_HIGH_MODEL=llama3.1:8b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Embeddings ---
RAG_EMBEDDING_PROVIDER=offline
# VECTOR_BACKEND=qdrant | memory | azure_ai_search
VECTOR_BACKEND=qdrant
# AZURE_SEARCH_ENDPOINT=https://YOUR.search.windows.net
# AZURE_SEARCH_API_KEY=...
# AZURE_SEARCH_INDEX=rlogistics-sops

# --- MCP Streamable HTTP (local) ---
MCP_HTTP_ENABLED=true
# MCP_API_KEY=  # defaults to RLOGISTICS_API_KEY

# --- Observability / spend ---
SPEND_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_EMBEDS_DAY=5000
SPEND_LIMIT_USD_DAY=5.0
EVAL_AUTO_CAPTURE=true
AGENT_MAX_STEPS=8
