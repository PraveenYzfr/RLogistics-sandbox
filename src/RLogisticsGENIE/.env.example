# RLogisticsGENIE local env example — copy to .env (do not commit secrets)

RLOGISTICS_URL=http://localhost:5088
RLOGISTICS_API_KEY=rlogistics-demo-coord-key-change-me
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
GENIE_LLM_MODE=offline

# Embeddings — switch with ONE of:
#   offline       = TF-IDF mock (no keys)
#   fastembed     = LOCAL neural ONNX (laptop)
#   ollama        = LOCAL / self-hosted via Ollama
#   azure_openai  = Azure OpenAI embeddings (enterprise Azure)
#   gemini        = Google Gemini embeddings (Google path)
#   openai        = public OpenAI API
RAG_EMBEDDING_PROVIDER=offline

# --- Local neural (ONNX) ---
# RAG_EMBEDDING_PROVIDER=fastembed
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Ollama (local / self-hosted) ---
# RAG_EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# First: ollama pull nomic-embed-text

# --- Azure OpenAI ---
# RAG_EMBEDDING_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini ---
# RAG_EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# Optional: RAG_EMBEDDING_DIMENSIONS=768

# --- Public OpenAI (lab) ---
# RAG_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
